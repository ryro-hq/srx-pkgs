// Experimental until this exact source and platform have native qualification.
pub struct Selection {
    version: PackagePinText;
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn @{name}(const selection: Selection) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({system = selection.system; libc = selection.libc;});
    recipe_ref(fn() -> Recipe {
        builders::recipe::named_recipe(build::gnu(source), "@{name}-${source.version}-${system}")
    })
}
