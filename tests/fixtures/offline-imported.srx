// Local imported result; no acquisition, build or historical receipt required.
// The same manifest contains distinct hello/glibc keys, both named out.
fn imported_glibc() -> std::Recipe {
    std::Recipe {
        package = std::Package { id = "glibc"; dependencies = []; };
        imported = std::Option::Some(std::ImportedResult {
            root = "offline-runtime-candidate";
            manifest = "96a1f642ce2bcddf0a947eae08e25b36a2ef8d14d7387fed73ff8a0425330015";
            entries = [std::ImportedOutput { output = "out"; key = "glibc"; }];
        });
    }
}

fn imported_hello(libc: std::RecipeRef<std::Recipe>) -> std::Recipe {
    std::Recipe {
        package = std::Package { id = "hello"; dependencies = []; };
        imported = std::Option::Some(std::ImportedResult {
            root = "offline-runtime-candidate";
            manifest = "96a1f642ce2bcddf0a947eae08e25b36a2ef8d14d7387fed73ff8a0425330015";
            entries = [std::ImportedOutput { output = "out"; key = "hello"; }];
        });
        commands = [std::Command {
            name = "hello"; output = "out"; path = "usr/bin/hello";
            loader = [std::RuntimeFile {
                output = std::recipe_output(libc, "out");
                path = "usr/lib/ld-linux-x86-64.so.2";
            }];
            libraries = [std::recipe_output(libc, "out")];
        }];
    }
}

mod factories {
    mod libc { pub fn recipe() -> std::Recipe { project::imported_glibc() } }
    mod hello { pub fn recipe() -> std::Recipe { project::imported_hello(project::libc) } }
}
