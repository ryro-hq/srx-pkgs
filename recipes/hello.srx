// Package identity, pinned acquisition and the bounded build are separate values.
fn hello_package() -> std::Package {
    std::Package { id = "hello"; dependencies = []; }
}

fn hello_sources() -> std::Acquisition { hello_source::acquisition() }

fn hello_build() -> std::Build {
    std::autotools_with_libc(std::BuildOptions {
        source_directory = "hello-2.12.1";
        timeout_seconds = 120;
    })
}

fn hello_build_inputs() -> std::BuildInputs {
    std::BuildInputs {
        selected = [std::recipe_output(project::glibc, "dev"), std::recipe_output(project::glibc, "out")];
    }
}

fn hello_command() -> std::Command {
    std::Command {
        name = "hello"; output = "out"; path = "usr/bin/hello";
        loader = [std::RuntimeFile { output = std::recipe_output(project::glibc, "out"); path = "usr/lib/ld-linux-x86-64.so.2"; }];
        libraries = [std::recipe_output(project::glibc, "out")];
    }
}

pub fn recipe() -> std::Recipe {
    std::Recipe {
        package = hello_package();
        acquisition = std::Option::Some(hello_sources());
        build = std::Option::Some(hello_build());
        build_inputs = std::Option::Some(hello_build_inputs());
        commands = [hello_command()];
    }
}
