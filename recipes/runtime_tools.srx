// ELF shape validation only; does not execute the supplied shell or pager.
pub fn static_validation() -> std::BuildText {
    std::build_text("import os, stat, struct, sys\n\ndef validate(path):\n    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n    with os.fdopen(fd, 'rb') as source:\n        before = os.fstat(source.fileno())\n        if not stat.S_ISREG(before.st_mode) or not before.st_mode & 0o111 or not 64 <= before.st_size <= 134217728:\n            raise ValueError('runtime helper must be a bounded executable regular file')\n        def read(offset, size):\n            if offset < 0 or size < 0 or offset + size > before.st_size:\n                raise ValueError('ELF range')\n            source.seek(offset)\n            data = source.read(size)\n            if len(data) != size:\n                raise ValueError('truncated ELF')\n            return data\n        header = read(0, 64)\n        if header[:7] != b'\\x7fELF\\x02\\x01\\x01':\n            raise ValueError('ELF64 little endian required')\n        kind, machine, version = struct.unpack_from('<HHI', header, 16)\n        entry, table = struct.unpack_from('<QQ', header, 24)\n        ehsize, entsize, count = struct.unpack_from('<HHH', header, 52)\n        if kind not in (2, 3) or machine != 62 or version != 1 or ehsize != 64 or entsize != 56 or not 1 <= count <= 256:\n            raise ValueError('unsupported ELF executable')\n        headers = read(table, count * 56)\n        executable = False\n        dynamic = False\n        for index in range(count):\n            tag, flags, offset, address, _, size, memory, align = struct.unpack_from('<IIQQQQQQ', headers, index * 56)\n            if offset + size > before.st_size or size > memory:\n                raise ValueError('ELF segment range')\n            if tag == 3:\n                raise ValueError('runtime helper has PT_INTERP')\n            if tag == 1 and flags & 1 and address <= entry < address + size:\n                executable = True\n            if tag == 2:\n                if dynamic or size > 65536 or size % 16:\n                    raise ValueError('dynamic section bounds')\n                dynamic = True\n                data = read(offset, size)\n                terminated = False\n                for position in range(0, size, 16):\n                    key, value = struct.unpack_from('<QQ', data, position)\n                    if key == 0:\n                        terminated = True\n                        break\n                    if key in (1, 14, 15, 29, 0x6ffffefa, 0x6ffffefb, 0x6ffffefc, 0x7ffffffd, 0x7fffffff):\n                        raise ValueError('external runtime dependency or loader directive')\n                if not terminated:\n                    raise ValueError('unterminated dynamic section')\n        if not executable:\n            raise ValueError('entry outside executable file-backed load')\n        after = os.fstat(source.fileno())\n        keys = lambda m: (m.st_dev, m.st_ino, m.st_size, m.st_mode, m.st_mtime_ns, m.st_ctime_ns)\n        if keys(before) != keys(after):\n            raise ValueError('runtime helper changed')\n\nfor path in sys.argv[1:]:\n    validate(path)\nif len(sys.argv) != 3:\n    raise ValueError('exact shell and pager inputs required')\n")
}
