pub struct Selection {
    version: PackagePinText = "2.44";
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn glibc_version(const selection: Selection) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            templates::recipe::named_recipe(
                build::bootstrap(source),
                "glibc-${source.version}-${system}"
            )
        })
}
// Existing bootstrap references keep their recipe identity and exact source.
pub fn recipe() -> Recipe {
    build::bootstrap(releases::source("2.44"))
}
pub fn managed_glibc_version(const selection: Selection, seed: lib::toolchain::Toolchain) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            templates::recipe::named_recipe(
                managed::build(seed, source),
                "glibc-managed-${source.version}-${system}"
            )
        })
}
// One shared reference keeps the runtime libc identical across GNU consumers.
pub let runtime = glibc_version({
        version = "2.44";
    });
