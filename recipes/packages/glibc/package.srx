pub struct Selection {
    version: PackagePinText;
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn glibc(const selection: Selection) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            builders::recipe::named_recipe(
                build::bootstrap(source),
                "glibc-${source.version}-${system}"
            )
        })
}
pub fn managed_glibc(const selection: Selection, seed: lib::toolchain::Toolchain) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            builders::recipe::named_recipe(
                managed::build(seed, source),
                "glibc-managed-${source.version}-${system}"
            )
        })
}
// One shared reference keeps the runtime libc identical across GNU consumers.
pub let runtime = glibc({
        version = "2.44";
    });
