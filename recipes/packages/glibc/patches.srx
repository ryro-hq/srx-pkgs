pub fn apply(source_directory: SourceDirectory, executable: BuildPath, environment: [BuildEnv]) -> [BuildStep] {
    apply_one(
        source_directory,
        executable,
        environment,
        "CVE-2026-19499.patch",
        std::files::read_text("assets/glibc/CVE-2026-19499.patch")
    ) ++ apply_one(
        source_directory,
        executable,
        environment,
        "CVE-2026-84243.patch",
        std::files::read_text("assets/glibc/CVE-2026-84243.patch")
    )
}
fn apply_one(
    source_directory: SourceDirectory,
    executable: BuildPath,
    environment: [BuildEnv],
    filename: SourceDirectory,
    contents: ConfigText
) -> [BuildStep] {
    let patch = BuildPath::Work("${filename}");
    [
        BuildStep::Write(BuildFile {
                path = patch;
                text = build_text("${contents}");
            }),
        builders::process::run(
            executable,
            BuildPath::Work("source/${source_directory}"),
            [
                build_text("--batch"),
                build_text("--forward"),
                build_text("--fuzz=0"),
                build_text("-p1"),
                build_text("-i"),
                build_path(patch)
            ],
            environment
        )
    ]
}
// `make test` prints the result but does not require PASS by default.
pub fn require_pass(test: ConfigText, shell: BuildPath, cwd: BuildPath, environment: [BuildEnv]) -> BuildStep {
    builders::process::run(
        shell,
        cwd,
        [
            build_text("-c"),
            build_text("IFS= read -r result < \"$1\" && [ \"$result\" = \"$2\" ]"),
            build_text("glibc-test"),
            build_text("${test}.test-result"),
            build_text("PASS: ${test}")
        ],
        environment
    )
}
