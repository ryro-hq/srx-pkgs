// Builder bootstrap tools. This does not authorize filesystem creation.
pub struct Selection {
    version: PackagePinText = "1.47.4";
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn e2fsprogs_bootstrap(const selection: Selection) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            templates::recipe::named_recipe(
                build::bootstrap(source),
                "e2fsprogs-bootstrap-${source.version}-${system}"
            )
        })
}
