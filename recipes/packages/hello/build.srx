pub fn gnu(source: support::Source) -> Recipe {
    builders::recipe::from_source({
            id = "hello";
            source = source;
            build = lib::gnu::autotools({
                    source_directory = "hello-${source.version}";
                    timeout_seconds = 180;
                });
            build_inputs = builders::recipe::selected_inputs([
                    recipe_output(glibc::runtime, "dev"),
                    recipe_output(glibc::runtime, "out")
                ]);
            commands = [builders::recipe::gnu_command("hello", "usr/bin/hello", glibc::runtime, [])];
        })
}
pub fn musl(source: support::Source) -> Recipe {
    builders::recipe::from_source({
            id = "hello";
            source = source;
            build = musl_build("hello-${source.version}");
            commands = [Command {
                    name = "hello";
                    output = "out";
                    path = "usr/bin/hello";
                }];
        })
}
fn musl_build(directory: SourceDirectory) -> Build {
    builders::autotools::build({
            directory = directory;
            configure = [
                build_text("./configure"),
                build_text("--disable-nls"),
                builders::process::argument("--prefix=", BuildPath::Installed("out", "usr"))
            ];
            environment = [
                builders::process::env("CC", build_text("/usr/bin/musl-gcc")),
                builders::process::env("LDFLAGS", build_text("-static"))
            ];
        })
}
