// Source-built bootstrap assembler/linker. The host seed remains explicit.
pub struct Selection {
    version: PackagePinText = "2.47";
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn binutils_bootstrap(const selection: Selection) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            templates::recipe::named_recipe(
                build::bootstrap(source),
                "binutils-bootstrap-${source.version}-${system}"
            )
        })
}
