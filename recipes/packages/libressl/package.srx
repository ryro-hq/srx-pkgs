pub struct Selection {
    version: PackagePinText;
    variant: PackagePinText = "default";
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn libressl(const selection: Selection) -> PackageRef<contracts::default::Settings> {
    let platform = lib::platform::direct({
            system = selection.system;
            libc = selection.libc;
        });
    let system = lib::platform::tag(platform);
    let source = releases::source(selection.version);
    let compatibility = releases::compatibility(selection.version, selection.variant, system);
    match system {
        "linux-x86_64-gnu" => reference(source, compatibility, system, build::gnu),
        "linux-x86_64-musl" => reference(source, compatibility, system, build::musl),
    }
}
fn reference(
    source: support::Source,
    compatibility: support::Compatibility,
    system: PackagePinText,
    build: fn(support::Source) -> Recipe
) -> PackageRef<contracts::default::Settings> {
    builders::configured::reference<contracts::default::Settings>({
            source = source;
            compatibility = compatibility;
            system = system;
            build = build;
            render = contracts::default::render;
        })
}
