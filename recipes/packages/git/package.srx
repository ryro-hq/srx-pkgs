// Managed construction requires the explicit providers documented in README.
pub struct Selection {
    version: PackagePinText;
    system: PackagePinText = "";
    libc: PackagePinText = "";
}
pub fn git(
    const selection: Selection,
    seed: lib::toolchain::Toolchain,
    libc: RecipeRef<Recipe>,
    zlib: RecipeRef<Recipe>,
    runtime_tools: OutputRef<Recipe>
) -> RecipeRef<Recipe> {
    let source = releases::source(selection.version);
    let system = lib::platform::gnu_x86_64({
            system = selection.system;
            libc = selection.libc;
        });
    recipe_ref(fn() -> Recipe {
            builders::recipe::named_recipe(
                build::managed(seed, libc, zlib, runtime_tools, source),
                "git-minimal-${source.version}-${system}"
            )
        })
}
