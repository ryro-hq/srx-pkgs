pub let nginx_1_30_6_to_1_30_8_04: BuildLiteral = """From 07c14df1341e261a400b37970eca8cfa275854c0 Mon Sep 17 00:00:00 2001
Subject: nginx 1.30.6 to 1.30.8 source backport (part 4)

Upstream release-to-release diff for src/ and auto/, excluding src/core/nginx.h (version metadata).

diff --git a/src/mail/ngx_mail_smtp_handler.c b/src/mail/ngx_mail_smtp_handler.c
index 8158c4fa1f55680147d31605c397914adca2b909..7cb4eee78485cb737da697732870993fa1be16ba 100644
--- a/src/mail/ngx_mail_smtp_handler.c
+++ b/src/mail/ngx_mail_smtp_handler.c
@@ -17,6 +17,7 @@ static ngx_int_t ngx_mail_smtp_validate_host(ngx_str_t *name);
 static void ngx_mail_smtp_resolve_name(ngx_event_t *rev);
 static void ngx_mail_smtp_resolve_name_handler(ngx_resolver_ctx_t *ctx);
 static void ngx_mail_smtp_block_reading(ngx_event_t *rev);
+static void ngx_mail_smtp_block_writing(ngx_event_t *wev);
 static void ngx_mail_smtp_greeting(ngx_mail_session_t *s, ngx_connection_t *c);
 static void ngx_mail_smtp_invalid_pipelining(ngx_event_t *rev);
 static ngx_int_t ngx_mail_smtp_create_buffer(ngx_mail_session_t *s,
@@ -92,6 +93,7 @@ ngx_mail_smtp_init_session(ngx_mail_session_t *s, ngx_connection_t *c)
 
     s->resolver_ctx = ctx;
     c->read->handler = ngx_mail_smtp_block_reading;
+    c->write->handler = ngx_mail_smtp_block_writing;
 
     if (ngx_resolve_addr(ctx) != NGX_OK) {
         ngx_mail_close_connection(c);
@@ -159,6 +161,7 @@ ngx_mail_smtp_resolve_addr_handler(ngx_resolver_ctx_t *ctx)
                    "address resolved: %V", &s->host);
 
     c->read->handler = ngx_mail_smtp_resolve_name;
+    c->write->handler = ngx_mail_send;
 
     ngx_post_event(c->read, &ngx_posted_events);
 }
@@ -220,6 +223,7 @@ ngx_mail_smtp_resolve_name(ngx_event_t *rev)
 
     s->resolver_ctx = ctx;
     c->read->handler = ngx_mail_smtp_block_reading;
+    c->write->handler = ngx_mail_smtp_block_writing;
 
     if (ngx_resolve_name(ctx) != NGX_OK) {
         ngx_mail_close_connection(c);
@@ -322,6 +326,38 @@ ngx_mail_smtp_block_reading(ngx_event_t *rev)
 }
 
 
+static void
+ngx_mail_smtp_block_writing(ngx_event_t *wev)
+{
+    ngx_connection_t    *c;
+    ngx_mail_session_t  *s;
+    ngx_resolver_ctx_t  *ctx;
+
+    c = wev->data;
+    s = c->data;
+
+    ngx_log_debug0(NGX_LOG_DEBUG_MAIL, c->log, 0, "smtp writing blocked");
+
+    if (ngx_handle_write_event(wev, 0) != NGX_OK) {
+
+        if (s->resolver_ctx) {
+            ctx = s->resolver_ctx;
+
+            if (ctx->handler == ngx_mail_smtp_resolve_addr_handler) {
+                ngx_resolve_addr_done(ctx);
+
+            } else if (ctx->handler == ngx_mail_smtp_resolve_name_handler) {
+                ngx_resolve_name_done(ctx);
+            }
+
+            s->resolver_ctx = NULL;
+        }
+
+        ngx_mail_close_connection(c);
+    }
+}
+
+
 static void
 ngx_mail_smtp_greeting(ngx_mail_session_t *s, ngx_connection_t *c)
 {
@@ -347,6 +383,8 @@ ngx_mail_smtp_greeting(ngx_mail_session_t *s, ngx_connection_t *c)
         ngx_post_event(c->read, &ngx_posted_events);
     }
 
+    c->write->handler = ngx_mail_send;
+
     if (sscf->greeting_delay) {
          c->read->handler = ngx_mail_smtp_invalid_pipelining;
          return;
diff --git a/src/stream/ngx_stream_ssl_module.c b/src/stream/ngx_stream_ssl_module.c
index 0e17cff4d96eba8b0d6aa8b5b492311213ce7e1b..12e2d348b13f7b86d5da5ded31292396e4e8b7c0 100644
--- a/src/stream/ngx_stream_ssl_module.c
+++ b/src/stream/ngx_stream_ssl_module.c
@@ -459,6 +459,8 @@ ngx_stream_ssl_handler(ngx_stream_session_t *s)
         }
     }
 
+    sscf = ngx_stream_get_module_srv_conf(s, ngx_stream_ssl_module);
+
     if (sscf->verify) {
         rc = SSL_get_verify_result(c->ssl->connection);
 
""";
pub let nginx_1_30_6_to_1_30_8_05: BuildLiteral = """From 07c14df1341e261a400b37970eca8cfa275854c0 Mon Sep 17 00:00:00 2001
Subject: nginx 1.30.6 to 1.30.8 source backport (part 5)

Upstream release-to-release diff for src/ and auto/, excluding src/core/nginx.h (version metadata).

diff --git a/src/stream/ngx_stream_ssl_preread_module.c b/src/stream/ngx_stream_ssl_preread_module.c
index 3fc83ff2f4c37d459935cfd9db3d831937843bee..7aa86699ded49a6ff1d57b14428ae6cd6e1d9031 100644
--- a/src/stream/ngx_stream_ssl_preread_module.c
+++ b/src/stream/ngx_stream_ssl_preread_module.c
@@ -224,6 +224,7 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
         sw_cs,              /* cipher_suites */
         sw_cm_len,          /* compression_methods length */
         sw_cm,              /* compression_methods */
+        sw_ext_len,         /* extensions length */
         sw_ext,             /* extension */
         sw_ext_header,      /* extension_type, extension_data length */
         sw_sni_len,         /* SNI length */
@@ -330,11 +331,20 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
                 return NGX_OK;
             }
 
-            state = sw_ext;
+            state = sw_ext_len;
             dst = p;
             size = 2;
             break;
 
+        case sw_ext_len:
+            if (left != (size_t) (p[0] << 8) + p[1]) {
+                ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                               "ssl preread: extensions length error");
+                return NGX_DECLINED;
+            }
+
+            /* fall through */
+
         case sw_ext:
             if (left == 0) {
                 return NGX_OK;
@@ -346,16 +356,32 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
             break;
 
         case sw_ext_header:
-            if (p[0] == 0 && p[1] == 0 && ctx->host.data == NULL) {
+            ext = (p[2] << 8) + p[3];
+
+            if (p[0] == 0 && p[1] == 0) {
                 /* SNI extension */
+
+                if (ctx->host.data != NULL) {
+                    ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                                   "ssl preread: duplicate SNI");
+                    return NGX_DECLINED;
+                }
+
                 state = sw_sni_len;
                 dst = p;
                 size = 2;
                 break;
             }
 
-            if (p[0] == 0 && p[1] == 16 && ctx->alpn.data == NULL) {
+            if (p[0] == 0 && p[1] == 16) {
                 /* ALPN extension */
+
+                if (ctx->alpn.data != NULL) {
+                    ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                                   "ssl preread: duplicate ALPN");
+                    return NGX_DECLINED;
+                }
+
                 state = sw_alpn_len;
                 dst = p;
                 size = 2;
@@ -372,11 +398,17 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
 
             state = sw_ext;
             dst = NULL;
-            size = (p[2] << 8) + p[3];
+            size = ext;
             break;
 
         case sw_sni_len:
-            ext = (p[0] << 8) + p[1];
+            if (ext < 5 || ext != 2 + (size_t) (p[0] << 8) + p[1]) {
+                ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                               "ssl preread: SNI format error");
+                return NGX_DECLINED;
+            }
+            ext -= 2;
+
             state = sw_sni_host_head;
             dst = p;
             size = 3;
@@ -416,7 +448,12 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
             break;
 
         case sw_alpn_len:
-            ext = (p[0] << 8) + p[1];
+            if (ext < 4 || ext != 2 + (size_t) (p[0] << 8) + p[1]) {
+                ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                               "ssl preread: ALPN format error");
+                return NGX_DECLINED;
+            }
+            ext -= 2;
 
             ctx->alpn.data = ngx_pnalloc(ctx->pool, ext);
             if (ctx->alpn.data == NULL) {
@@ -469,6 +506,14 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
             break;
 
         case sw_supver_len:
+            size = p[0];
+
+            if (ext < 3 || ext != 1 + size) {
+                ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
+                               "ssl preread: supported_versions format error");
+                return NGX_DECLINED;
+            }
+
             ngx_log_debug0(NGX_LOG_DEBUG_STREAM, ctx->log, 0,
                            "ssl preread: supported_versions");
 
@@ -478,7 +523,6 @@ ngx_stream_ssl_preread_parse_record(ngx_stream_ssl_preread_ctx_t *ctx,
 
             state = sw_ext;
             dst = NULL;
-            size = p[0];
             break;
         }
 
""";
