fn reference(
    source: support::Source,
    compatibility: support::Compatibility,
    system: PackagePinText,
    build: fn(support::Source) -> Recipe
) -> PackageRef<contracts::minimal::Settings> {
    builders::configured::reference<contracts::minimal::Settings>({
            source = source;
            compatibility = compatibility;
            system = system;
            build = build;
            render = contracts::minimal::render;
            integrate = Option::Some(integration::nginx_validated);
        })
}
pub fn gnu(source: support::Source, compatibility: support::Compatibility) -> PackageRef<contracts::minimal::Settings> {
    reference(source, compatibility, "linux-x86_64-gnu", build::gnu)
}
pub fn musl(source: support::Source, compatibility: support::Compatibility) -> PackageRef<contracts::minimal::Settings> {
    reference(source, compatibility, "linux-x86_64-musl", build::musl)
}
