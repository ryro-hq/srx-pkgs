// Exact source pins for the experimental managed factory.
pub fn source(const version: PackagePinText) -> support::Source {
    match version {
        "1.3.2" => support::Source {
            version = "1.3.2";
            url = "https://zlib.net/fossils/zlib-1.3.2.tar.gz";
            sha256 = "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16";
            maximum_bytes = 2097152;
        }
    }
}
