pub fn nginx() -> std::PackageRef<contracts_nginx::Settings> package("nginx", "1.30.6", "minimal", "linux-x86_64-musl") {
    std::with_package_service(std::package_ref(std::recipe_ref(raw_recipe), "1.30.6", "minimal", "linux-x86_64-musl", "6fdaea8e0648f7913cf5ce418df0066baac3d6d23d274de0d0c094c79ea4e61e", contracts_nginx::render), project::nginx_validated)
}

pub fn recipe() -> std::Recipe { std::recipe_value(std::package_recipe(nginx())) }

fn raw_recipe() -> std::Recipe { std::Recipe {
        package = std::Package { id = "nginx"; dependencies = []; };
        acquisition = std::Option::Some(versioned_nginx_source_1_30_6::acquisition());
        build = std::Option::Some(nginx_version_build::build("nginx-1.30.6", std::build_text("--with-cc=/usr/bin/musl-gcc"), [], [], [std::build_text("--with-ld-opt=-static")]));
        
        commands = [std::Command { name = "nginx"; output = "out"; path = "usr/bin/nginx";  }];
    } }
